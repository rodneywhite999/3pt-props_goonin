# Copy to .env and fill in at least ONE channel.

# --- ntfy (free phone push; recommended) ---
# Pick a long, hard-to-guess topic name and subscribe to it in the ntfy app.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# --- Microsoft Teams (Workflows webhook URL) ---
TEAMS_WEBHOOK_URL=

# --- WhatsApp via Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_TO=+15551234567

# --- WhatsApp via CallMeBot (free, personal) ---
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Options ---
# POLL_SECONDS=15
# TEAMS_FILTER=          # e.g. KC,BUF  (empty = every team)
